# =============================================
# INSTABOT PLATFORM - Variáveis de Ambiente
# =============================================

# Token de verificação do webhook Meta (você escolhe qualquer string)
VERIFY_TOKEN=meu_token_secreto_123

# Chave da API Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-...

# Senha do painel de administração
ADMIN_PASSWORD=admin123

# Porta do servidor
PORT=3000

# URL pública do servidor (necessário após deploy)
# Ex: https://instabot.railway.app
PUBLIC_URL=https://sua-url-aqui.railway.app
